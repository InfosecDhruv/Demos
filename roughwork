(netsh wlan show profiles | Select-String "All User Profile" | ForEach-Object { ($_ -split ":")[1].Trim() }) | ForEach-Object { "Profile: $_`nPassword: $(netsh wlan show profile name='$_' key=clear | Select-String 'Key Content' | ForEach-Object { ($_ -split ': ')[1].Trim() })" } | Out-File "$env:USERPROFILE\Desktop\WiFiPasswords.txt"
(for /f "tokens=2 delims=:" %i in ('netsh wlan show profiles ^| findstr "All User Profile"') do @echo Profile: %i && @netsh wlan show profile name=%i key=clear ^| findstr "Key Content") > "%USERPROFILE%\Desktop\WiFiPasswords.txt"
